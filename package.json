{
  "name": "logout-question",
  "version": "1.0.0",
  "private": true,
  "description": "Interview exercise: implement logout in an Angular SPA with a cookie-based session.",
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:api\" \"npm:web\"",
    "api": "node server/index.mjs",
    "web": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.0"
  }
}
